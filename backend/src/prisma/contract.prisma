// use prisma-8
enum Status {
  pending
  paid
  shipped
  cancelled
}

model Customer {
  id        Int                @id @default(autoincrement())
  email     String             @unique
  name      String
  city      String
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt

  orders    Order[]

  @@map("customers")
}

model Category {
  id        Int                @id @default(autoincrement())
  name      String             @unique
  products  Product[]
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@map("categories")
}

model Product {
  id          Int                @id @default(autoincrement())
  name        String
  price       Int
  category_id Int
  createdAt   DateTime           @default(now()) @onCreate(now())
  updatedAt   temporal.UpdatedAt
  category    Category           @relation(fields: [category_id], references: [id])

  @@map("products")
}

model Order {
  id           Int         @id @default(autoincrement())
  customer_id  Int
  total_amount Int
  status       Status      @default(pending)
  order_date   DateTime
  customer     Customer    @relation(fields: [customer_id], references: [id])
  order_items  OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         Int   @id @default(autoincrement())
  order_id   Int
  product_id Int
  unit_price Int
  quantity   Int

  order      Order @relation(fields: [order_id], references: [id])
  product    Product @relation(fields: [product_id],references: [id])

  @@check(expression: sql`quantity > 0`, name: "quantity_positive")
  @@check(expression: sql`unit_price > 0`,name: "unit_price_positive")
  @@map("order_items")
}
